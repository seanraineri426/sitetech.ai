# SiteTech Connector Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit secrets to the repository

# Procore Configuration (DMSA + Client Credentials)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
PROCORE_BASE_URL=https://api.procore.com
PROCORE_AUTH_URL=https://login.procore.com
# Set to "true" to record API responses as fixtures (development only)
PROCORE_RECORD_MODE=false

# Microsoft Graph Configuration (App-only Client Credentials)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
