# Node environment
NODE_ENV=development

# Supabase Configuration
# Get these values from:
# 1. Run `pnpm supabase start` locally
# 2. Copy the API URL and anon key from the output
# 3. For production, get from your Supabase project settings

# Public keys (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only keys (NEVER expose to browser)
# Only needed for background jobs and admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SiteTech Connector Environment Variables
# Copy to .env.local and fill in your values
# Secrets should be in server env or Supabase Vault, never committed

# Procore Configuration (DMSA + Client Credentials)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
PROCORE_BASE_URL=https://api.procore.com
PROCORE_AUTH_URL=https://login.procore.com

# Microsoft Graph Configuration (App-only Client Credentials)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_SITE_ID=
